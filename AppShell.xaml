<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MatriculaSudamericano.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MatriculaSudamericano.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Title="Matrícula Sudamericano">

    <ShellContent Title="Iniciar sesión"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="LoginPage" />

    <ShellContent Title="Matrícula"
                  ContentTemplate="{DataTemplate views:MatriculaPage}"
                  Route="MatriculaPage" />
</Shell>