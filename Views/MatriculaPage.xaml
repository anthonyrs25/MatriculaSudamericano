<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MatriculaSudamericano.ViewModels"
             x:Class="MatriculaSudamericano.Views.MatriculaPage"
             x:DataType="vm:MatriculaViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White"
             Title="Formulario de Matrícula">

    <ContentPage.Resources>
        <Color x:Key="AzulOscuro">#1E3A6E</Color>
        <Color x:Key="Turquesa">#1494A9</Color>
        <Color x:Key="TextoOscuro">#333333</Color>

        <Style x:Key="EtiquetaCampo" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource TextoOscuro}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="TextoPanel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style x:Key="Caja" TargetType="Border">
            <Setter Property="Stroke" Value="#B8B8B8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 1. Logo -->
        <VerticalStackLayout Padding="24,12" Spacing="0">
            <Label Text="INSTITUTO DE TECNOLOGÍAS" FontSize="10" FontAttributes="Bold"
                   TextColor="{StaticResource AzulOscuro}" />
            <Label Text="SUDAMERICANO" FontSize="28" FontAttributes="Bold,Italic"
                   TextColor="{StaticResource Turquesa}" />
        </VerticalStackLayout>

        <!-- 2. Barra azul con degradado -->
        <Grid Grid.Row="1" Padding="24,10" ColumnDefinitions="*,Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#6F8FCB" Offset="0" />
                    <GradientStop Color="#3A5A9E" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Label Text="Formulario de Matrícula" FontSize="17" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Cerrar sesión" Command="{Binding CerrarSesionCommand}"
                    BackgroundColor="Transparent" TextColor="White" BorderColor="White"
                    BorderWidth="1" CornerRadius="4" FontSize="13" Padding="12,4" />
        </Grid>

        <!-- 3. Contenido con scroll -->
        <ScrollView Grid.Row="2">
            <Grid x:Name="contenido" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto"
                  ColumnSpacing="32" RowSpacing="24" Padding="16,24" HorizontalOptions="Center">

                <!-- Formulario -->
                <VerticalStackLayout x:Name="formulario" Spacing="18">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="FASE A - GRADO" FontSize="26" FontAttributes="Bold"
                               TextColor="{StaticResource AzulOscuro}" HorizontalTextAlignment="Center" />
                        <Label Text="Formulario de registro"
                               TextColor="{StaticResource TextoOscuro}" HorizontalTextAlignment="Center" />
                        <Label Text="Complete la siguiente información para realizar su inscripción."
                               TextColor="{StaticResource TextoOscuro}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Recuadro "Datos Personales" -->
                    <Grid Margin="0,10,0,0">
                        <Border Stroke="#C8C8C8" StrokeThickness="1" Padding="20,26,20,20">
                            <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="12" RowSpacing="10">

                                <Label Text="Identificación:" Style="{StaticResource EtiquetaCampo}" />
                                <Border Grid.Column="1" Style="{StaticResource Caja}">
                                    <Picker Title="{OnPlatform Android='Tipo'}"
                                            ItemsSource="{Binding TiposIdentificacion}"
                                            SelectedItem="{Binding TipoIdentificacion}" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Caja}">
                                    <Entry Placeholder="Número" MaxLength="20"
                                           Text="{Binding NumeroIdentificacion}" />
                                </Border>

                                <Label Grid.Row="1" Text="Apellidos:" Style="{StaticResource EtiquetaCampo}" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Caja}">
                                    <Entry Placeholder="Paterno" MaxLength="40" Text="{Binding ApellidoPaterno}" />
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Caja}">
                                    <Entry Placeholder="Materno" MaxLength="40" Text="{Binding ApellidoMaterno}" />
                                </Border>

                                <Label Grid.Row="2" Text="Nombres completos:" Style="{StaticResource EtiquetaCampo}" />
                                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Caja}">
                                    <Entry MaxLength="60" Text="{Binding Nombres}" />
                                </Border>

                                <Label Grid.Row="3" Text="Teléfono personal:" Style="{StaticResource EtiquetaCampo}" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Caja}">
                                    <Entry Placeholder="09XXXXXXXX" MaxLength="10" Keyboard="Telephone"
                                           Text="{Binding Telefono}" />
                                </Border>

                                <Label Grid.Row="4" Text="Correo personal:" Style="{StaticResource EtiquetaCampo}" />
                                <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Caja}">
                                    <Entry MaxLength="80" Keyboard="Email" Text="{Binding Correo}" />
                                </Border>

                                <Label Grid.Row="5" Text="Confirmar correo:" Style="{StaticResource EtiquetaCampo}" />
                                <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Caja}">
                                    <Entry MaxLength="80" Keyboard="Email" Text="{Binding ConfirmarCorreo}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Label Text=" Datos Personales " BackgroundColor="White" TextColor="#777777"
                               FontSize="14" Margin="12,0,0,0" TranslationY="-10"
                               HorizontalOptions="Start" VerticalOptions="Start" />
                    </Grid>

                    <!-- Carrera, modalidad y campus -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="10" Padding="20,0">
                        <Label Text="Carrera:" Style="{StaticResource EtiquetaCampo}" />
                        <Border Grid.Column="1" Style="{StaticResource Caja}">
                            <Picker Title="{OnPlatform Android='Seleccione...'}"
                                    ItemsSource="{Binding Carreras}" SelectedItem="{Binding Carrera}" />
                        </Border>

                        <Label Grid.Row="1" Text="Modalidad:" Style="{StaticResource EtiquetaCampo}" />
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Caja}">
                            <Picker Title="{OnPlatform Android='Seleccione...'}"
                                    ItemsSource="{Binding Modalidades}" SelectedItem="{Binding Modalidad}" />
                        </Border>

                        <Label Grid.Row="2" Text="Campus:" Style="{StaticResource EtiquetaCampo}" />
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Caja}">
                            <Picker Title="{OnPlatform Android='Seleccione...'}"
                                    ItemsSource="{Binding CampusDisponibles}" SelectedItem="{Binding Campus}" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#C8C8C8" Margin="0,6" />

                    <Button Text="Enviar Inscripción" Command="{Binding EnviarCommand}"
                            HorizontalOptions="Center" WidthRequest="260"
                            BackgroundColor="White" TextColor="{StaticResource TextoOscuro}"
                            BorderColor="#B0B0B0" BorderWidth="1" CornerRadius="0" FontSize="13" />
                </VerticalStackLayout>

                <!-- Panel lateral -->
                <VerticalStackLayout x:Name="panelInfo" Grid.Column="1" Spacing="16" VerticalOptions="Start">
                    <Border BackgroundColor="{StaticResource Turquesa}" StrokeThickness="0" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Información" FontAttributes="Bold" FontSize="15" TextColor="White" />
                            <Label Text="💬 099 648 3605" TextDecorations="Underline" Style="{StaticResource TextoPanel}" />
                            <Label Text="📞 02 255 5741 - Ext: 101/102" Style="{StaticResource TextoPanel}" />
                            <Label Text="✉️ its@sudamericano.edu.ec" Style="{StaticResource TextoPanel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Stroke="#1494A9" StrokeThickness="3" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Enlaces" FontAttributes="Bold" TextColor="{StaticResource TextoOscuro}" />
                            <Label Text="&gt;&gt; Preguntas Frecuentes" TextColor="{StaticResource TextoOscuro}" />
                            <Label Text="&gt;&gt; Calendario Académico" TextColor="{StaticResource TextoOscuro}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>