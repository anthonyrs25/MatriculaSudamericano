<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MatriculaSudamericano.ViewModels"
             x:Class="MatriculaSudamericano.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF2F8"
             Title="Iniciar sesión">

    <ContentPage.Resources>
        <Style x:Key="Caja" TargetType="Border">
            <Setter Property="Stroke" Value="#C8C8C8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 4" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16">
        <Border BackgroundColor="White" Stroke="#D0D5DD" StrokeThickness="1"
                StrokeShape="RoundRectangle 8" Padding="28" WidthRequest="320"
                HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">

                <VerticalStackLayout Spacing="0">
                    <Label Text="INSTITUTO DE TECNOLOGÍAS" FontSize="10" FontAttributes="Bold"
                           TextColor="#1E3A6E" HorizontalTextAlignment="Center" />
                    <Label Text="SUDAMERICANO" FontSize="26" FontAttributes="Bold,Italic"
                           TextColor="#1494A9" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Label Text="Iniciar sesión" FontSize="18" FontAttributes="Bold"
                       TextColor="#333333" Margin="0,10,0,0" />

                <Border Style="{StaticResource Caja}">
                    <Entry Placeholder="Usuario" Text="{Binding Usuario}" MaxLength="30" />
                </Border>

                <Border Style="{StaticResource Caja}">
                    <Entry Placeholder="Contraseña" Text="{Binding Contrasena}" IsPassword="True"
                           MaxLength="50" ReturnCommand="{Binding IngresarCommand}" />
                </Border>

                <Button Text="Ingresar" Command="{Binding IngresarCommand}"
                        BackgroundColor="#3A5A9E" TextColor="White" CornerRadius="4" />

                <Label Text="Acceso solo para personal autorizado." FontSize="12"
                       TextColor="#777777" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>